  "cards": [
    {
      "dot": "cyan",
      "title": "分层契约(CI 强制)",
      "items": [
        "依赖严格单向:壳 → 工具/会话 → agent → ai",
        "sigma_tools 与 sigma_session 兄弟层,互不依赖(independence)",
        "内置与扩展工具同一条注册路径;task 可派后台 sub_agent(≤3)",
        "三道门禁:lint-imports · mypy --strict · pytest"
      ]
    },
    {
      "dot": "emerald",
      "title": "上下文预算",
      "items": [
        "常驻区 ≤ 3500 token 且逐字节稳定,是 prompt cache 的充要条件",
        "压缩是视图不是改写:树上原文不动,摘要降级成 user 追加尾部",
        "技能目录进常驻区,正文由 load_skill 按需追加,不破坏缓存前缀"
      ]
    },
    {
      "dot": "rose",
      "title": "安全边界(不是沙箱)",
      "items": [
        "L1 写路径:write / edit / bash.cwd 越出工作区即拒绝",
        "L2 影子 git:写批次前快照,sigma --rollback 整体回退且可再回滚",
        "L3 钩子未做;bash 仍以用户权限执行任意命令",
        "web_search / web_fetch 有 key 才注册,额度用尽自动禁用"
      ]
    }
  ]
