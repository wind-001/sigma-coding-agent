# sigma 的配置示例
#
# 用法：复制成 .env（项目根，已被 .gitignore 覆盖）或 ~/.sigma/.env（推荐，在仓库之外），
# 然后只填你需要的那几行。**不要把这个文件改成真 key 再提交。**
#
# 解析优先级（高 → 低）：
#   命令行参数 > 环境变量 > ~/.sigma/.env > <仓库>/.env
# 启动横幅会打印 key 的来源，所以"改了 .env 却没生效"不用猜。

# ── 模型（必填一项，二选一）──────────────────────────────────────────────
# OpenAI 兼容协议的 key。预设见 --preset：deepseek / moonshot / zhipu / dashscope / ollama
SIGMA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 模型端点与模型名（可选，覆盖预设）────────────────────────────────────
# 不填则用 --preset 自带的默认值（默认预设是 deepseek）
# SIGMA_BASE_URL=https://api.deepseek.com
# SIGMA_MODEL=deepseek-chat

# ── 可选工具：联网搜索（Tavily）──────────────────────────────────────────
# 免费档 1000 credits/月（basic 每次 1 / advanced 每次 2），用尽后工具自动禁用。
# 额度账本：~/.sigma/tavily_usage.json
# TAVILY_API_KEY=tvly-dev-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 可选工具：网页精读（Firecrawl）───────────────────────────────────────
# 免费档 1000 credits/月，一次 scrape = 1 credit；**单次最多 2 条 URL**（框架硬闸）。
# 额度账本：~/.sigma/firecrawl_usage.json
# FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
